#
# bromfiets.brf  --  BromNav routing profile for a Dutch bromfiets (yellow plate, 45 km/h)
#
# Legal model (RVV 1990, as mapped in Dutch OSM):
#   * motorway / motorroad=yes (A- and G3-autoweg)          -> forbidden
#   * moped=no (C14, or G11/G13 cycle path)                 -> forbidden
#   * moped=use_sidepath (a parallel G12a bromfietspad is compulsory) -> forbidden
#   * highway=cycleway                                      -> only with moped=yes|designated (G12a)
#   * footway / path / pedestrian / steps / bridleway       -> only with moped=yes|designated
#   * busway, service=bus                                   -> only with moped=yes|designated
#   * motor_vehicle / vehicle / access = no|private         -> forbidden unless moped=yes|designated
#   * destination / delivery                                -> allowed with a penalty (we deliver!)
#
# The same file also serves two other vehicles (global variable "vehicle", set by the app):
#   1 = snorfiets (blue plate, 25 km/h): OSM "mofa". Uses fietspaden (G11) and roads; not G13
#       (mofa=no), not where a compulsory cycle path runs alongside (bicycle/mofa=use_sidepath).
#   2 = e-bike up to 25 km/h without plate: legally a bicycle, follows the "bicycle" tags.
#
# Speeds: kinematic model, vmax 45 km/h (25 for vehicle 1 and 2).
#
---model:btools.router.KinematicModel

---context:global

assign vehicle = 0   # %vehicle% | 0 = bromfiets (yellow plate 45), 1 = snorfiets (blue plate 25), 2 = e-bike 25 (no plate) | number
assign isbrom = equal vehicle 0
assign issnor = equal vehicle 1
assign isbike = equal vehicle 2

assign validForCars         = true
assign validForBikes        = false

# allow untagged highway=cycleway (no moped tag at all). Dutch default is "no" inside
# built-up areas, so this is off: reliability first.
assign allow_untagged_cycleway = false   # %allow_untagged_cycleway% | Use cycleways without moped tag | boolean
assign avoid_fast_roads        = true    # %avoid_fast_roads% | Prefer roads <= 50 km/h | boolean

assign vmax             = if isbrom then 45 else 25
assign totalweight      = if isbike then 120 else 190    # vehicle + rider + delivery box (kg)
assign f_roll           = if isbike then 12 else 28      # N  (190 kg * 9.81 * 0.015)
assign f_air            = 0.38   # N/(m/s)^2  0.5*cw*A*rho
assign f_recup          = 400    # N braking force (~2 m/s^2)
assign p_standby        = 0
assign recup_efficiency = 0

assign turnInstructionMode  = 1
assign add_beeline          = false
assign pass1coefficient     = 1.3

---context:way

assign classifier_none  = 1
assign classifier_ferry = 2

assign isresidentialorliving = or highway=residential|living_street living_street=yes

assign mopedexplicitok = moped=yes|designated
assign mopedexplicitno = moped=no|use_sidepath
assign mofaexplicitok  = or mofa=yes|designated mopedexplicitok
assign mofaexplicitno  = mofa=no|use_sidepath
assign bikeexplicitok  = bicycle=yes|designated|permissive|destination
assign bikeexplicitno  = bicycle=no|use_sidepath|dismount

# path-like ways (cycle paths, foot paths ...)
assign ispathlike = highway=cycleway|footway|path|pedestrian|steps|bridleway|platform|corridor|busway

# road-like ways where a bromfiets may drive by default
assign isroadlike = or highway=trunk|trunk_link|primary|primary_link|secondary|secondary_link
                    or highway=tertiary|tertiary_link|unclassified|service
                    or isresidentialorliving
                    or bicycle_road=yes|designated cyclestreet=yes|designated

assign isbusonly = or highway=busway service=bus

assign isfastroad = or highway=motorway|motorway_link motorroad=yes

assign defaultaccess =
       if isfastroad then false
       else if isbusonly then false
       else if highway=cycleway then ( if isbrom then allow_untagged_cycleway else true )
       else if highway=path|footway then ( if isbrom then false else bicycle=yes|designated )
       else if ispathlike then false
       else if highway=track then ( if isbrom then tracktype=grade1 else true )
       else if route=ferry then true
       else isroadlike

# generic restrictions (motor_vehicle includes mopeds in OSM semantics)
assign genericaccess =
       switch motor_vehicle=
              switch vehicle=
                     switch access=
                            defaultaccess
                            and defaultaccess access=yes|permissive|designated|destination|delivery|customers
                     and defaultaccess vehicle=yes|permissive|designated|destination
              if isbike then defaultaccess   # motor_vehicle=no does not bind a bicycle
              else and defaultaccess motor_vehicle=yes|permissive|designated|destination

# "mopedaccess" = may the selected vehicle use this way
assign mopedaccess =
       if isfastroad then false
       else if isbrom then
            ( if mopedexplicitno then false else if mopedexplicitok then true else genericaccess )
       else if issnor then
            ( if mofaexplicitno then false else if mofaexplicitok then true
              else if and isroadlike bicycle=use_sidepath then false   # compulsory fietspad alongside
              else genericaccess )
       else ( if bikeexplicitno then false else if bikeexplicitok then true else genericaccess )

assign isdestinationonly =
       or access=destination|delivery|customers
       or vehicle=destination
          motor_vehicle=destination

assign isbromfietspad = and highway=cycleway|path|footway mopedaccess

assign initialclassifier =
     if route=ferry then classifier_ferry
     else classifier_none

assign initialcost =
     if      ( and highway= not route=ferry ) then 10000
     else if ( equal initialclassifier classifier_ferry ) then 10000
     else 0

assign accessspeedlimit = if mopedaccess then 999 else 0

assign isbadoneway = if and isbike oneway:bicycle=no then false
                    else if reversedirection=yes then ( if oneway= then junction=roundabout else oneway=yes|true|1 ) else oneway=-1
# a one-way cycle path (oneway:bicycle) also binds mopeds on a bromfietspad
assign isbadonewaypath = and isbromfietspad if reversedirection=yes then oneway:bicycle=yes else false
assign onewayspeedlimit = if or isbadoneway isbadonewaypath then 0 else 999

assign islinktype = highway=motorway_link|trunk_link|primary_link|secondary_link|tertiary_link

assign maxspeed_surface =
  switch or surface= surface=paved|asphalt|concrete 999
  switch surface=paving_stones|sett 30
  switch surface=cobblestone 20
  switch surface=compacted|fine_gravel 20
  10

# implicit speeds as a bromfiets really rides them in Groningen
assign maxspeed_implicit =
  switch isbromfietspad                        30
  switch highway=trunk|trunk_link|primary|primary_link   45
  switch highway=secondary|secondary_link|tertiary|tertiary_link   45
  switch highway=unclassified                  40
  switch highway=living_street                 15
  switch or bicycle_road=yes|designated cyclestreet=yes|designated  30
  switch highway=residential                   30
  switch highway=service                       15
  switch highway=track                         20
  switch route=ferry                           10
  30

assign maxspeed_dir =
  if reversedirection=yes then
    switch maxspeed:backward=30 30 switch maxspeed:backward=20 20 switch maxspeed:backward=10 10 999
  else
    switch maxspeed:forward=30 30 switch maxspeed:forward=20 20 switch maxspeed:forward=10 10 999

assign maxspeed_explicit =
  switch maxspeed=30 30
  switch maxspeed=20 20
  switch maxspeed=10 10
  switch zone:maxspeed=30 30
  switch zone:maxspeed=20 20
  maxspeed_dir

assign maxspeed =
  min onewayspeedlimit
  min accessspeedlimit
  min maxspeed_explicit
  min maxspeed_implicit
  maxspeed_surface

# road speed limit >= 60 (e.g. 70 km/h N-roads) – legal if not use_sidepath, but uncomfortable
assign isfastsign = maxspeed=60|70|80|90|100

assign costfactor =
  if ( equal maxspeed 0 ) then 10000
  else min 9999
  add ( if isdestinationonly then 0.6 else 0 )
  add ( if and avoid_fast_roads isfastsign then 0.5 else 0 )
  0

assign minspeed = 0

# way priorities used for voice hint generation
assign priorityclassifier =
  if      ( highway=trunk                     ) then  28
  else if ( highway=trunk_link                ) then  27
  else if ( highway=primary                   ) then  26
  else if ( highway=primary_link              ) then  25
  else if ( highway=secondary                 ) then  24
  else if ( highway=secondary_link            ) then  23
  else if ( highway=tertiary                  ) then  22
  else if ( highway=tertiary_link             ) then  21
  else if ( highway=unclassified              ) then  20
  else if ( isbromfietspad                    ) then  10
  else if ( isresidentialorliving             ) then  6
  else if ( highway=service                   ) then  6
  else if ( highway=track                     ) then  4
  else 0

assign isgoodoneway = if reversedirection=yes then oneway=-1
                      else if oneway= then junction=roundabout else oneway=yes|true|1
assign isroundabout = junction=roundabout
assign isgoodforcars = if greater priorityclassifier 6 then true
                  else if or isresidentialorliving highway=service then true
                  else false

assign classifiermask add          isbadoneway
                      add multiply isgoodoneway   2
                      add multiply isroundabout   4
                      add multiply islinktype     8
                      add multiply isgoodforcars 16
                      add multiply isresidentialorliving 32
                          multiply isdestinationonly 64

# make sure these tags are reported per segment (the app uses them for colouring
# and road <-> bromfietspad voice hints)
assign dummyUsage = add moped= add mofa= add maxspeed= add bicycle= add segregated= cycleway=

---context:node

# a bromfiets passes bollards and cycle barriers; gates need explicit access
assign motornodeaccess =
       switch motor_vehicle=
              switch vehicle=
                     switch access=
                            not barrier=gate|lift_gate|block|chain|swing_gate|turnstile|kissing_gate|stile|bus_trap|motorcycle_barrier|fence|wall
                            access=yes|permissive|designated|destination
                     vehicle=yes|permissive|designated|destination
              motor_vehicle=yes|permissive|designated|destination

# an e-bike is a bicycle: motor_vehicle=no does not apply, bicycle=* decides
assign bikenodeaccess =
       if bicycle=no|dismount then false
       else if bicycle=yes|designated|permissive|destination then true
       else switch vehicle=
              switch access=
                     not barrier=gate|lift_gate|block|chain|swing_gate|turnstile|kissing_gate|stile|fence|wall
                     access=yes|permissive|designated|destination
              vehicle=yes|permissive|designated|destination

assign nodeaccess = if isbike then bikenodeaccess else motornodeaccess

assign initialcost =
       switch nodeaccess
              switch barrier=bollard|cycle_barrier 30 0
              1000000

assign maxspeed =
       if or crossing=traffic_signals highway=traffic_signals then
         switch greater way:priorityclassifier 22 5
         switch greater way:priorityclassifier 20 3
         1
       else if railway=level_crossing then 0
       else if barrier=cycle_barrier|bollard then 8
       else 999
